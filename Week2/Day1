1)  Valid Anagram (Java Code)

class Solution {
    public boolean isAnagram(String s, String t) {
        if(s.length()!=t.length()){
            return false;
        }
        int[] freq= new int[26];
        for(int i=0;i<s.length();i++){
            freq[s.charAt(i)-'a']++;//increasing the freq count of each char in s(initially its 0 for every element in java).  
            freq[t.charAt(i)-'a']--;//decreasing the freq of each char in t    
        }
        for(int i=0;i<26;i++){
            if(freq[i]!=0){// after increament and decreament if there freq is same than they will become 0
               return false;
            }
        }
        return true;
    }
}


2)  First Unique Character in a String(Java Code)

class Solution {
    public int firstUniqChar(String s) {
        int[] freq= new int[26];
        int n=s.length();
        for(int i=0;i<n;i++){
            char ch=s.charAt(i);
            freq[ch-'a']++;
        }
        for(int i=0;i<n;i++){
            char ch=s.charAt(i);
            if(freq[ch-'a']==1){
                return i;
            }
        }
        return -1;
    }
}


3)   Ransom Note(Java Code)

class Solution {
    public boolean canConstruct(String ransomNote, String magazine) {
        int[] freq = new int[26];

        for (int i = 0; i < magazine.length(); i++) {
            freq[magazine.charAt(i) - 'a']++;
        }

        for (int i = 0; i < ransomNote.length(); i++) {
            freq[ransomNote.charAt(i) - 'a']--;

            if (freq[ransomNote.charAt(i) - 'a'] < 0) {
                return false;
            }
        }

        return true;
    }
}
